# The base image is pinned by digest, the one of the multi-arch manifest list of
# the tag, so that a moved tag is not picked up silently. To update it, check
# the new image and take its digest from:
#   docker buildx imagetools inspect ocaml/opam:ubuntu-24.04-ocaml-5.2
FROM ocaml/opam:ubuntu-24.04-ocaml-5.2@sha256:9c6d9d8b50ebde4f2373d866d093946314b2bc04d4a07cd574bef8bef14b9928

USER opam

# Rust channel must match Octez pin (deps/tezos/rust-toolchain).
COPY deps/tezos/rust-toolchain /tmp/octez-rust-toolchain

# rustup-init is downloaded as a versioned binary, and its SHA-256 is checked
# against the one pinned here before it runs: a mismatch stops the build.
# The checksums are published next to each binary, as
# https://static.rust-lang.org/rustup/archive/<version>/<target>/rustup-init.sha256
# To update rustup, change the version and both checksums together.
ARG RUSTUP_VERSION=1.29.3
ARG RUSTUP_SHA256_X86_64=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
ARG RUSTUP_SHA256_AARCH64=9f608c142e0e38a78957d0661ba1dfaf0b6fb37184cfaa4b9a0aa57af6184282

# Install system dependencies and Rust
RUN sudo apt-get update &&                                                       \
    sudo apt-get -y install wget git &&                                          \
    case "$(uname -m)" in                                                        \
      x86_64)                                                                    \
        RUSTUP_TARGET=x86_64-unknown-linux-gnu;                                  \
        RUSTUP_SHA256=$RUSTUP_SHA256_X86_64 ;;                                   \
      aarch64)                                                                   \
        RUSTUP_TARGET=aarch64-unknown-linux-gnu;                                 \
        RUSTUP_SHA256=$RUSTUP_SHA256_AARCH64 ;;                                  \
      *)                                                                         \
        echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;              \
    esac &&                                                                      \
    RUSTUP_TOOLCHAIN=$(tr -d ' \n\r\t' < /tmp/octez-rust-toolchain) &&           \
    wget --https-only -O /tmp/rustup-init                                        \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUSTUP_TARGET}/rustup-init" && \
    echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c - &&                 \
    chmod 0755 /tmp/rustup-init &&                                               \
    /tmp/rustup-init --profile minimal --default-toolchain "$RUSTUP_TOOLCHAIN" -y && \
    rm /tmp/rustup-init
ENV PATH=/home/opam/.cargo/bin:$PATH
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true

# Install OCaml build dependencies
# Only copy files needed for dependency resolution to maximize layer cache hits.
# This layer is invalidated only when the opam lock file or version scripts change.
WORKDIR /opt/tezos
COPY --chown=opam:opam deps/tezos/scripts/version.sh scripts/version.sh
COPY --chown=opam:opam deps/tezos/opam opam
RUN sudo chown opam:opam /opt/tezos
RUN . ./scripts/version.sh &&                                                      \
    opam repository add tezos                                                      \
      "https://github.com/ocaml/opam-repository.git#${opam_repository_tag}"        \
      --dont-select 2>/dev/null ||                                                 \
    opam repository set-url tezos                                                  \
      "https://github.com/ocaml/opam-repository.git#${opam_repository_tag}"        \
      --dont-select &&                                                             \
    opam switch create /opt/tezos --repositories=tezos                             \
      "ocaml-base-compiler.${ocaml_version}" --no-install &&                       \
    eval "$(opam env)" &&                                                          \
    opam repository remove default 2>/dev/null || true &&                          \
    export OPAMYES=true &&                                                         \
    OPAMASSUMEDEPEXTS=true opam install conf-rust conf-rust-2021 &&                \
    opam install opam-depext &&                                                    \
    opam pin add -ny stdcompat.19                                                  \
      "https://github.com/thierry-martinez/stdcompat/archive/d53390d788027fe0a2282c4745eb3d1626341f99.tar.gz" && \
    sed -i '/^pin-depends:/,/^\]$/d' opam/virtual/octez-deps.opam.locked &&        \
    opam pin add -ny --locked octez-deps opam/virtual/ &&                          \
    opam depext octez-deps &&                                                      \
    opam pin remove -y octez-deps &&                                               \
    opam install opam/virtual/octez-deps.opam.locked                               \
      --deps-only --criteria="-notuptodate,-changed,-removed"

# Build and install the Tezos libs that tests/generate uses.
# They are a small part of the Octez workspace: build only their `.install`
# targets, which builds only what they need, not all of it with `@install`.
# -j 1: the wasmer C-stubs file is huge and a single gcc invocation can use
#   several GB of RAM; running anything else at the same time OOM-kills the build.
COPY --chown=opam:opam deps/tezos /opt/tezos
ENV CARGO_BUILD_JOBS=2
ARG OCTEZ_PACKAGES="                                        \
        octez-internal-libs                                 \
        octez-libs                                          \
        octez-riscv-api                                     \
        octez-riscv-pvm                                     \
        octez-proto-libs                                    \
        tezt-tezos                                          \
        octez-protocol-023-PtSeouLo-libs                    \
        tezos-benchmark-type-inference-023-PtSeouLo         \
        tezos-micheline-rewriting                           \
        tezos-benchmark-023-PtSeouLo                        \
        tezos-benchmark                                     \
        octez-version                                       \
        octez-protocol-compiler-compat                      \
        octez-protocol-compiler                             \
        octez-rust-deps                                     \
        bls12-381                                           \
        tezos-protocol-023-PtSeouLo                         \
        tezos-benchmarks-proto-023-PtSeouLo                 \
        octez-shell-libs"
RUN eval $(opam env) && dune build -j 1 $(printf '%s.install ' $OCTEZ_PACKAGES)

RUN eval $(opam env) && dune install $OCTEZ_PACKAGES &&     \
    dune clean &&                                           \
    rm -rf _opam/.opam-switch/build _opam/.opam-switch/sources

ENV OPAMSWITCH=/opt/tezos
ENV PATH=/opt/tezos/_opam/bin:$PATH
